# Every environment variable the services read, with working local defaults.
#
# Nothing loads this file automatically. Use it with uv:
#   uv run --env-file .env.example python -m mcp_gateway
# or copy it to .env, edit, and pass --env-file .env.
# docker-compose.yml sets its own values and does not need this file.
#
# JSON values are single-quoted so the double quotes inside them survive parsing.

# ---- Shared ----
# Log level for the HTTP services (Tasks 2-4): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---- Task 1: MCP server (python -m customer_mcp) ----
# stdio transport: the MCP client starts the process, so there is no host or port.
# Logs go to stderr as JSON lines.
CUSTOMER_MCP_LOG_LEVEL=INFO

# ---- Task 2: MCP security gateway (python -m mcp_gateway) ----
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_DOWNSTREAM_URL=http://127.0.0.1:9000/mcp
# Token table as JSON: {"<token>": {"subject": "...", "role": "admin" | "viewer"}}
GATEWAY_TOKENS='{"admin-token-0123456789abcdef":{"subject":"alice@example.com","role":"admin"},"viewer-token-0123456789abcdef":{"subject":"bob@example.com","role":"viewer"}}'
# Or load the same JSON from a file (e.g. a mounted secret); this takes precedence:
# GATEWAY_TOKENS_FILE=/run/secrets/gateway_tokens.json
# Hide admin_* tools from viewers in tools/list (off: forward tools/list unchanged)
GATEWAY_HIDE_UNAUTHORIZED_TOOLS=false
GATEWAY_MAX_BODY_BYTES=1000000
GATEWAY_DOWNSTREAM_TIMEOUT_S=30

# ---- Task 3: streaming PII guardrail (python -m stream_guardrail) ----
GUARDRAIL_HOST=127.0.0.1
GUARDRAIL_PORT=8090
GUARDRAIL_UPSTREAM_URL=http://127.0.0.1:9100/v1
# To use a real OpenAI-compatible provider instead of the mock:
# GUARDRAIL_UPSTREAM_URL=https://api.openai.com/v1
# GUARDRAIL_UPSTREAM_API_KEY=sk-...
GUARDRAIL_UPSTREAM_TIMEOUT_S=60

# ---- Task 4: rate limiter + failover router (python -m model_router) ----
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8100
ROUTER_DB_PATH=data/router.db
ROUTER_TOKENS_PER_MINUTE=50000
ROUTER_ATTEMPT_TIMEOUT_MS=3000
# Tenant API keys as JSON: {"<api key>": "<tenant id>"}
ROUTER_TENANT_KEYS='{"sk-tenant-alpha-0123456789":"alpha","sk-tenant-beta-0123456789":"beta"}'
ROUTER_PRIMARY_URL=http://127.0.0.1:9101/v1
# ROUTER_PRIMARY_API_KEY=
# ROUTER_PRIMARY_MODEL=
ROUTER_SECONDARY_URL=http://127.0.0.1:9102/v1
# ROUTER_SECONDARY_API_KEY=
# Optional: send a different (e.g. cheaper) model to the backup provider
ROUTER_SECONDARY_MODEL=backup-model

# ---- Mock upstreams (local development only) ----
# These are easier to set as flags, e.g.
#   uv run python -m mocks.llm_provider --port 9101 --name primary
#   uv run python -m mocks.mcp_downstream --port 9000 [--sse]
# MOCK_HOST=127.0.0.1
# MOCK_PORT=9100
# MOCK_PROVIDER_NAME=mock-provider
# MOCK_SSE=0
